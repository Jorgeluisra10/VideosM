# secretos
.env

# dependencias y temporales
node_modules/
trabajo/tmp/
trabajo/ia/debug/

# los videos terminados y capturas pesan: no van al repositorio
trabajo/salida/*.mp4
trabajo/archivo/*/*.mp4

# tus proyectos (datos y fotos del cliente) y el panel
proyectos/*
!proyectos/LEEME.txt
trabajo/panel/
public/fotos/*
!public/fotos/LEEME.txt
trabajo/anim/
trabajo/salida/guion-locucion.txt

# audios de voz ya pagados (caché por hash) y datos personales del Panel de Videos (métricas, copias de seguridad, videos)
cache/
data/*
!data/LEEME.txt
