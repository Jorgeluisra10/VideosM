{
  "titulo": "¿Tu intestino es un segundo cerebro?",
  "scenes": [
    {"t": "PIEZA", "voz": "Tu intestino se maneja solo.", "dur": 4.4, "h": "TU INTESTINO SE MANEJA SOLO", "w": "SOLO", "cap": "sistema nervioso entérico", "pieza": {"id": "int-gancho"}},
    {"t": "PIEZA", "voz": "Tiene ciento sesenta y ocho millones de neuronas. Tu cerebro, ochenta y seis mil millones.", "dur": 5.6, "h": "¿UN SEGUNDO CEREBRO?", "w": "CEREBRO", "cap": "no: es una red", "pieza": {"id": "int-escala"}},
    {"t": "PIEZA", "voz": "Si cortas el nervio vago, el intestino sigue moviéndose.", "dur": 5.0, "h": "SIGUE MOVIÉNDOSE", "w": "SIGUE", "cap": "reflejo peristáltico", "pieza": {"id": "int-autonomo"}},
    {"t": "PIEZA", "voz": "Cuando el bolo estira la pared, detrás aprieta y delante se relaja.", "dur": 5.8, "h": "DETRÁS APRIETA, DELANTE AFLOJA", "w": "APRIETA", "cap": "peristalsis", "pieza": {"id": "int-peristalsis"}},
    {"t": "PIEZA", "voz": "Sin esas neuronas en un tramo del colon, el alimento no avanza.", "dur": 5.6, "h": "SIN NEURONAS, NO HAY AVANCE", "w": "NEURONAS", "cap": "enfermedad de Hirschsprung", "pieza": {"id": "int-hirsch"}},
    {"t": "PIEZA", "voz": "Casi el noventa por ciento de tu serotonina se fabrica ahí, pero no llega al cerebro.", "dur": 5.8, "h": "90 % DE TU SEROTONINA", "w": "SEROTONINA", "cap": "no cruza la barrera", "pieza": {"id": "int-sero"}},
    {"t": "PIEZA", "voz": "El nervio vago sube más información de la que baja: el ochenta por ciento.", "dur": 5.0, "h": "EL NERVIO VAGO SUBE", "w": "VAGO", "cap": "80 % hacia el cerebro", "pieza": {"id": "int-vago"}},
    {"t": "PIEZA", "voz": "No es un segundo cerebro: es una red que habla con el primero.", "dur": 5.2, "h": "UNA RED QUE HABLA", "w": "RED", "cap": "eje intestino-cerebro", "pieza": {"id": "int-cierre"}},
    {"t": "CTA", "voz": "Guárdalo y compártelo con alguien curioso.", "dur": 3.8, "h": "GUÁRDALO Y COMPÁRTELO", "w": "COMPÁRTELO", "sub": "Más ciencia en SINAPSIS"}
