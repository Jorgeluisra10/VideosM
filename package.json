{
  "name": "videmed",
  "version": "1.0.0",
  "description": "Productor automático de reels (Video-as-Code) · modo dual: medicina-ar / inmobiliario-co",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "actualizar": "node scripts/actualizar.mjs",
    "limpiar": "node scripts/limpiar.mjs",
    "panel": "node scripts/panel/servidor.mjs",
    "panel:abrir": "node scripts/panel/servidor.mjs --abrir",
    "start": "remotion studio src/index.ts",
    "prestart": "node scripts/generar-sfx.mjs --solo-faltantes",
    "voz": "node scripts/generar-voz.mjs",
    "voz:prod": "node scripts/generar-voz.mjs --mode=prod",
    "voz:muestras": "node scripts/anim/muestras-voz.mjs",
    "crear": "node scripts/crear.mjs",
    "crear-video": "node scripts/crear-video.mjs",
    "plantilla": "node scripts/plantilla.mjs",
    "preproducir": "node scripts/generar-sfx.mjs --solo-faltantes",
    "producir": "node scripts/producir.mjs",
    "sfx": "node scripts/generar-sfx.mjs",
    "iconos": "node scripts/sync-iconos.mjs",
    "check": "tsc --noEmit",
    "test": "npm run check && node scripts/ia/probar.mjs && node scripts/anim/probar.mjs",
    "anim:prueba": "node scripts/anim/probar.mjs",
    "anim:ejemplo": "node scripts/anim/ejemplo.mjs",
    "anim:generar": "node scripts/anim/generar.mjs",
    "anim:previa": "node scripts/anim/previa.mjs",
    "anim:render": "node scripts/render.mjs --composicion=Animacion",
    "qa": "node scripts/qa.mjs",
    "still": "remotion still src/index.ts Portada trabajo/salida/portada.jpg --image-format=jpeg --jpeg-quality=95",
    "prebuild": "node scripts/generar-sfx.mjs --solo-faltantes",
    "build": "node scripts/render.mjs",
    "entregables": "node scripts/entregables.mjs",
    "ia": "node scripts/ia/agente.mjs",
    "ia:validar": "node scripts/ia/validar.mjs",
    "ia:diagnostico": "node scripts/ia/diagnostico.mjs",
    "ia:prueba": "node scripts/ia/probar.mjs",
    "ia:capturas": "node scripts/ia/capturas.mjs",
    "ia:prompt": "node scripts/ia/exportar-prompt.mjs",
    "ia:importar": "node scripts/ia/importar-plan.mjs",
    "ia:mock": "node scripts/ia/mock-server.mjs",
    "proyecto": "node scripts/proyecto.mjs"
  },
  "keywords": [
    "remotion",
    "medicine",
    "real-estate",
    "video",
    "education",
    "reels"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@react-three/fiber": "8.17.10",
    "@remotion/cli": "4.0.536",
    "@remotion/media-utils": "4.0.536",
    "@remotion/paths": "4.0.536",
    "@remotion/player": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "@remotion/shapes": "4.0.536",
    "@remotion/three": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "healthicons-react": "3.5.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.536",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@remotion/bundler": "4.0.536",
    "@types/node": "^22.8.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.170.0",
    "esbuild": "0.28.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.3"
  }
}
